<Window x:Class="Finance_App.ExpenseAddEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Finance_App"
        mc:Ignorable="d"
        SizeToContent="Height"
        Title="ExpenseAddEditView" Width="400"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/CrudButtonStyle.xaml"/>
                <ResourceDictionary Source="/Styles/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/Styles/ErrorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="22"
            FontWeight="Bold"
            FontFamily="Cascadia Mono"
            Margin="0,0,0,15"
            x:Name="TitleText"/>

        <DatePicker Grid.Row="1"
            FontFamily="Cascadia Mono"
            FontSize="14"
            Margin="0,0,0,10"
            x:Name="DatePicker"/>
        <TextBlock Grid.Row="2" Grid.Column="0"
            Style="{StaticResource ErrorTextBlockStyle}"
            x:Name="DateError"/>

        <TextBlock Grid.Row="3"
            Text="Amount:"
            FontFamily="Cascadia Mono"
            FontSize="14"
            Margin="0,5"/>
        <TextBox Grid.Row="4"
            FontFamily="Cascadia Mono"
            FontSize="14"
            Margin="0,0,0,10"
            x:Name="AmountBox"/>
        <TextBlock Grid.Row="5" Grid.Column="0"
            Style="{StaticResource ErrorTextBlockStyle}"
            x:Name="AmountError"/>

        <TextBlock Grid.Row="6"
            Text="Category:"
            FontFamily="Cascadia Mono"
            FontSize="14"
            Margin="0,5"/>
        <ComboBox x:Name="CategoryBox" Grid.Row="7" FontFamily="Cascadia Mono" FontSize="16" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="8" Grid.Column="0"
            Style="{StaticResource ErrorTextBlockStyle}"
            x:Name="CategoryError"/>
        
        <TextBlock Grid.Row="9"
            Text="Note:"
            FontFamily="Cascadia Mono"
            FontSize="14"
            Margin="0,5"/>
        <TextBox x:Name="NoteBox" Grid.Row="10"
                 AcceptsReturn="True"
                 Height="60"
                 FontFamily="Cascadia Mono"
                 FontSize="14"
                 TextWrapping="Wrap"/>

        <StackPanel Grid.Row="11"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Cancel"
                    Width="80"
                    Margin="5"
                    Style="{StaticResource TealButtonStyle}"
                    FontSize="14"
                    Height="32"
                    Click="Cancel_Click"/>

            <Button x:Name="SaveButton"
                    Content="Save"
                    Width="80"
                    Margin="5"
                    Style="{StaticResource AddButton}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
