<Window x:Class="Finance_App.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Finance_App"
        mc:Ignorable="d"
        Title="RegisterWindow" Width="800"
        MinWidth="415" MinHeight="550"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/Styles/Icons.xaml"/>
                <ResourceDictionary Source="/Styles/ErrorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Rectangle  Grid.Column="0"
            Fill="#567C8D"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Width="100"
            x:Name="LeftRectangle"/>

        <Grid Grid.ColumnSpan="1" Grid.Column="1" 
          Margin="20,10,20,10" 
          MaxWidth="400"
          x:Name="MiddleForm">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Space for icons -->
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <!-- Register Title / 0-->
                <RowDefinition Height="Auto"/>

                <!-- General Error / 1 -->
                <RowDefinition Height="Auto"/>

                <!-- Username Label / 2 -->
                <RowDefinition Height="Auto"/>
                <!-- Username Input / 3 -->
                <RowDefinition Height="Auto"/>
                <!-- Username Error / 4 -->
                <RowDefinition Height="Auto"/>

                <!-- Email Label / 5 -->
                <RowDefinition Height="Auto"/>
                <!-- Email Input / 6 -->
                <RowDefinition Height="Auto"/>
                <!-- Email Error / 7 -->
                <RowDefinition Height="Auto"/>

                <!-- Password Label / 8 -->
                <RowDefinition Height="Auto"/>
                <!-- Password Input / 9 -->
                <RowDefinition Height="Auto"/>
                <!-- Password Repeater Label / 10 -->
                <RowDefinition Height="Auto"/>
                <!-- Password Repeater Input / 11 -->
                <RowDefinition Height="Auto"/>
                <!-- Passwords Error / 12 -->
                <RowDefinition Height="Auto"/>

                <!-- Register Button / 13 -->
                <RowDefinition Height="Auto"/>
                
                <!-- Go Back / 14 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                Text="Register"
                FontFamily="Cascadia Mono"
                FontSize="25"
                FontWeight="Bold" 
                HorizontalAlignment="Center"
                Padding="2"
                Margin="0,0,0,10"/>

            <Border Grid.Row="1" Grid.Column="0"
                Background="#FFFDE0E0"
                BorderBrush="#FFD00000"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8"
                Margin="0,10,0,10"
                Visibility="Collapsed"
                x:Name="GeneralErrorBorder">

                <TextBlock x:Name="GeneralErrorText"
                   Foreground="#D00000"
                   FontFamily="Cascadia Mono"
                   FontSize="12"
                   TextWrapping="Wrap"/>
            </Border>

            <!-- Username -->
            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Username"
                Margin="0,10,0,5"
                FontFamily="Cascadia Mono"
                FontSize="15"
                Padding="2"/>

            <TextBox Grid.Row="3" Grid.Column="0"
                TextWrapping="Wrap"
                Margin="0,0,0,10"
                Text=""
                FontFamily="Cascadia Mono"
                FontSize="15"
                Height="25"
                VerticalContentAlignment="Center"
                x:Name="UsernameInput"/>

            <TextBlock Grid.Row="4" Grid.Column="0"
                Style="{StaticResource ErrorTextBlockStyle}"
                x:Name="UsernameError"/>

            <!-- Email -->
            <Label Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Email"
                Margin="0,10,0,5"
                FontFamily="Cascadia Mono"
                FontSize="15"
                Padding="2"/>

            <TextBox Grid.Row="6" Grid.Column="0"
                TextWrapping="Wrap"
                Margin="0,0,0,10"
                Text=""
                FontFamily="Cascadia Mono"
                FontSize="15"
                Height="25"
                VerticalContentAlignment="Center"
                x:Name="EmailInput"/>

            <TextBlock Grid.Row="7" Grid.Column="0"
                Style="{StaticResource ErrorTextBlockStyle}"
                x:Name="EmailError"/>

            <!-- Password -->
            <Label Grid.Row="8" Grid.Column="0"
                Content="Password"
                Margin="0,10,0,5"
                FontFamily="Cascadia Mono"
                FontSize="15"
                Padding="2"/>

            <PasswordBox Grid.Row="9" Grid.Column="0"
                Height="25"
                FontFamily="Cascadia Mono"
                FontSize="15"
                VerticalContentAlignment="Center"
                x:Name="PasswordInvisible"/>

            <TextBox Grid.Row="9" Grid.Column="0"
                Height="25"
                FontFamily="Cascadia Mono"
                FontSize="15"
                VerticalContentAlignment="Center"
                Visibility="Collapsed"
                x:Name="PasswordVisible"/>

            <Button Grid.Row="9" Grid.Column="1" 
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                VerticalAlignment="Top"
                Padding="0"
 
                x:Name="PasswordToggleButton"
                Click="TogglePasswordVisibility">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>

                <Viewbox Width="22" Height="22">
                    <Path x:Name="EyeIcon"
              Fill="Gray"
              Data="{StaticResource EyeOpenIcon}"/>
                </Viewbox>

            </Button>

            <!-- Repeat Password -->
            <Label Grid.Row="10" Grid.Column="0"
                Content="Repeat Password"
                Margin="0,10,0,5"
                FontFamily="Cascadia Mono"
                FontSize="15"
                Padding="2"/>

            <PasswordBox Grid.Row="11" Grid.Column="0"
                Height="25"
                FontFamily="Cascadia Mono"
                FontSize="15"
                VerticalContentAlignment="Center"
                Margin="0,0,0,5"
                x:Name="PasswordInvisibleRepeat"/>

            <TextBox Grid.Row="11" Grid.Column="0"
                Height="25"
                FontFamily="Cascadia Mono"
                FontSize="15"
                VerticalContentAlignment="Center"
                Visibility="Collapsed"
                Margin="0,0,0,5"
                x:Name="PasswordVisibleRepeat"/>

            <Button Grid.Row="11" Grid.Column="1" 
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                VerticalAlignment="Top"
                Padding="0"
                x:Name="PasswordRepeatToggleButton"
                Click="TogglePasswordVisibility">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>

                <Viewbox Width="22" Height="22">
                    <Path x:Name="EyeIconRepeat"
                            Fill="Gray"
                            Data="{StaticResource EyeOpenIcon}"/>
                </Viewbox>

            </Button>

            <TextBlock Grid.Row="12" Grid.Column="0"
                Style="{StaticResource ErrorTextBlockStyle}"
                x:Name="PasswordError"/>

            <Button Grid.Row="13" Grid.Column="0"
                Style="{StaticResource TealButtonStyle}"
                Content="Register"
                Height="30"
                FontSize="15"
                Margin="0,20,0,10"
                x:Name="RegisterButton"
                Click="RegisterButton_Click"/>

            <TextBlock Grid.Row="14" Grid.Column="0"
                FontFamily="Cascadia Mono" 
                HorizontalAlignment="Center"
                FontSize="15"
                Padding="2"
                TextWrapping="Wrap">
                
                Have an account? 
                <Hyperlink Click="LoginLink_Click">Login</Hyperlink>

            </TextBlock>
        </Grid>

        <Rectangle Grid.Column="2" 
            Fill="#567C8D" 
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Width="100"
            x:Name="RightRectangle"/>

    </Grid>
</Window>
